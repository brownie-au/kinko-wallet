# Server-only, owner-controlled FREE Upstash Redis database.
# Existing Vercel KV integrations use these names. Never prefix secrets with VITE_.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative supported names:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional authenticated discovery for Base, Polygon and BNB Smart Chain.
# Set only in the test project's Preview environment; never prefix with VITE_.
# Leave blank for existing public explorer/native/manual-contract behaviour.
# Owner must use a free plan, monitor its quota and leave paid overages disabled.
ALCHEMY_API_KEY=
# No frontend keys or paid data subscriptions are required.
